# Postgres connection string (Neon, Supabase, or any Postgres).
# Neon: create a project at https://neon.tech and copy the pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The password you type at /admin/login. Choose something long.
ADMIN_PASSWORD=""

# Signs the admin session cookie. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# Vercel Blob read/write token, for image uploads in the admin.
# Vercel dashboard -> Storage -> Blob -> create a store -> copy the token.
BLOB_READ_WRITE_TOKEN=""
