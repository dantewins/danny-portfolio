generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  // Tiptap document JSON. Rendered to HTML server-side, never with dangerouslySetInnerHTML.
  body        Json
  coverSrc    String?
  coverAlt    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

model CaseStudy {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  category         String
  shortDescription String
  dek              String
  role             String
  // Display string such as "July 2025", not a sortable date.
  publishedLabel   String
  stack            String[]
  repository       String?
  live             String?
  // Key into the icon set in components/project-symbol.tsx. Chosen in the admin.
  icon             String        @default("note")
  heroSrc          String
  heroAlt          String
  heroWidth        Int
  heroHeight       Int
  flow             String[]
  takeaway         String
  // Drives both the homepage list and the circular next-project link.
  order            Int           @default(0)
  sections         CaseSection[]
  slides           CaseSlide[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([order])
}

// A composed hero slide: a real in-app screenshot plus the line that says what
// the screen is doing. Rendered in CSS rather than flattened to an image, so it
// stays editable and stays sharp.
model CaseSlide {
  id          String    @id @default(cuid())
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  caseStudyId String
  order       Int
  // Names the screen, e.g. "Matchmaking". Optional.
  eyebrow     String    @default("")
  // Asterisks mark the words rendered in the site's italic serif accent.
  headline    String
  subhead     String    @default("")
  imageSrc    String
  imageAlt    String
  imageWidth  Int       @default(1440)
  imageHeight Int       @default(930)
  // light | ink
  theme       String    @default("light")

  @@index([caseStudyId, order])
}

model CaseSection {
  id          String    @id @default(cuid())
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  caseStudyId String
  order       Int
  // prose | code | figure | decision | comparison
  kind        String
  // The #anchor the sidebar nav scrolls to.
  anchor      String
  nav         String
  title       String
  // Variant-specific payload, validated against the CaseSection union on read.
  data        Json

  @@index([caseStudyId, order])
}
